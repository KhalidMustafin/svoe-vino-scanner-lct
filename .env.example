# Настройки сканера. Для Docker: `cp .env.example .env` и поправить пути блока 1 — compose читает
# .env сам. Для нативного запуска те же SVS_* задаются окружением (`set -a; . ./.env; set +a`),
# и тогда нужны ещё SVS_DATA_DIR и SVS_DATASET_DIR (блок 3): в Docker их задаёт compose.
# Пустое значение переменной SVS_* — умолчание кода (app/api/config.py, app/api/field.py).
# Значения с пробелами — в кавычках: файл читают и compose, и bash.

# ============================================================ 1. Docker: пути машины → тома
# Пачка данных (deploy/pack_data.sh): index/, gt/, catalog/, somm/ → /data (только чтение).
SVS_DATA_HOST_DIR=./data
# ОБЯЗАТЕЛЬНО. Распакованный датасет организатора со strapi_output0709.csv → /dataset.
# Без выгрузки карточка остаётся без описаний: сервис стартует, но в журнале «Карточки без
# описаний» (app/api/cards.py:184), а в /v1/health catalog.cards.csv = null.
# например: SVS_DATASET_HOST_DIR="../Датасет" (папка со strapi_output0709.csv и распакованным eval/)
SVS_DATASET_HOST_DIR=
# 1 (так в этом образце) — скачать веса SigLIP при сборке образа: ровно ревизию индекса, только
# зрительная башня. 0 (умолчание compose.yml и Dockerfile, если переменной нет) — образ без весов,
# их даёт том SVS_HF_HUB_HOST_DIR ниже.
SVS_SIGLIP_AT_BUILD=1
# Только при SVS_SIGLIP_AT_BUILD=0: кэш Hugging Face с весами SigLIP (каталог, где лежит
# models--google--siglip2-so400m-patch14-384): обычный ~/.cache/huggingface/hub или обрезанный до
# зрительной башни scripts/trim_vision_weights.py (1,7 ГБ вместо 4,5). При 1 том не читается
# (веса rubert-tiny2 для SVS_SOMM_SAFETY=1 из него тоже не видны); если папки нет, Docker создаст
# её пустой — это нормально.
SVS_HF_HUB_HOST_DIR=../siglip-vision-hub
# Каталог моделей нативной Ollama, чтобы не качать модель чтения ещё раз (3,4 ГБ). Пусто — том
# compose `ollama-models`, модель скачает сервис ollama-pull.
# Windows:
# OLLAMA_MODELS_HOST_DIR=C:/Users/<вы>/.ollama/models
# Linux, Ollama из установщика:
# OLLAMA_MODELS_HOST_DIR=/usr/share/ollama/.ollama/models
OLLAMA_VERSION=0.33.2
# Порт на машине. Скрипт организатора ждёт 8080.
SVS_PUBLISH_PORT=8080

# ============================================================ 2. Сервис (app/api/config.py)
# Ollama: контейнер compose (`ollama`); нативная Ollama из контейнера — http://host.docker.internal:11434,
# при нативном запуске сервиса — http://127.0.0.1:11434 (умолчание кода).
SVS_OLLAMA_URL=http://ollama:11434
# Модель чтения этикетки. resolve обучен на её чтениях; другая — предупреждение в /v1/health.
SVS_VLM_MODEL=qwen3.5:4b
SVS_VLM_KEEP_ALIVE=24h
# Общий бюджет ответа и бюджет чтения этикетки, мс. Скрипт организатора ждёт 10 000 мс.
# На процессоре чтение в 5 000 мс не укладывается (README, «Запуск в Docker»): там либо эти
# значения (ответ в срок, но часто без текста), либо 600000/540000 (полная цепочка, минуты).
SVS_BUDGET_MS=8000
SVS_VLM_TIMEOUT_MS=5000
# off — всегда slug; ooc_only — отказ по правилу S10 (slug null). Скрипт засчитывает только slug.
SVS_ABSTAIN=off
# Кандидатов CV; обязан совпасть с top-K обучения модели resolve (20), иначе сервис не стартует.
SVS_TOP_K=20
SVS_MAX_UPLOAD_MB=25
# Модель CV; обязана совпасть с моделью индекса, иначе сервис не стартует.
SVS_CV_MODEL=google/siglip2-so400m-patch14-384
# Пути к файлам по отдельности. Пусто — от SVS_DATA_DIR / SVS_DATASET_DIR:
SVS_INDEX_PATH=
SVS_RESOLVE_MODEL=
SVS_LEXICON_PATH=
SVS_ATTRS_PATH=
SVS_CATALOG_CSV=
SVS_PHOTO_MAP=
SVS_CACHE_DIR=
#   SVS_INDEX_PATH      $SVS_DATA_DIR/index/visual-s2so400m.npz
#   SVS_RESOLVE_MODEL   configs/resolve/s2so400m-vlm35-lw-pool.json (в репозитории); при
#                       SVS_CANDIDATE=off — configs/resolve/s2so400m-vlm35-goal.json
#   SVS_LEXICON_PATH    $SVS_DATA_DIR/index/lexicon.json
#   SVS_ATTRS_PATH      $SVS_DATA_DIR/gt/gt_tokens.jsonl
#   SVS_CATALOG_CSV     $SVS_DATASET_DIR/strapi_output0709.csv — описания карточек
#   SVS_PHOTO_MAP       $SVS_DATA_DIR/catalog/slug_photo_map.csv
#   SVS_CACHE_DIR       data/cache репозитория — кэш чтений стендов bench; сервис его не читает
# Живые карточки портала (Э3, research/2026-09-25_acc/PREREG_E3.md): 1/true/on/yes — комплект
# «CSV + 71 карточка портала, чьего вина нет в CSV» (scripts/build_live_set.py), 0/false/off/no —
# только CSV. Флаг переключает вместе умолчания индекса, gt и словаря:
#   SVS_INDEX_PATH      $SVS_DATA_DIR/index/visual-s2so400m-live71.npz
#   SVS_ATTRS_PATH      $SVS_DATA_DIR/gt/gt_tokens-live71.jsonl
#   SVS_LEXICON_PATH    $SVS_DATA_DIR/index/lexicon-live71.json
# Явные пути выше главнее флага. Нормировка CV в живом индексе заморожена по строкам CSV: счёт CV
# вин CSV тот же. Ответ на кадре вина CSV всё же может смениться: карточка портала входит в top-20,
# словарь и признаки каталога шире (на kr — 1 смена из 617, research/2026-09-25_acc/E3_RESULT.md).
# Комплект — копия базы на момент сборки: после пересборки индекса, gt или словаря CSV его
# собирают заново. Живой gt — объявленная производная gt CSV (configs/resolve/gt_lineage.json).
# У живых карточек свой индекс, а карта адаптера поиска собрана под индекс CSV: с флагом нужен
# SVS_CANDIDATE=off, иначе сервис не стартует. Пусто — умолчание кода
# (app/api/config.py: LIVE_CARDS_DEFAULT — выключен по воротам kr Э3; включать, только если
# организатор сверяет ответы по живому порталу).
SVS_LIVE_CARDS=
# Путь поиска и выбора (фундаментальный трек 26.09, research/2026-09-26_fund/PREREG_final.md).
# Пусто — adapter-lw-ranker: адаптер поиска LW (обученное выбеливание векторов SigLIP) и ранкер
# configs/resolve/s2so400m-vlm35-lw-pool.json, обученный на его выдаче. Принят по одному просмотру
# замороженного kr-test: 94,5 % «то же вино» против 89,6 % у прежнего пути (p = 0,0015).
#   off (или none)      прежний продукт: поиск без адаптера, ранкер -goal (бит в бит как до 26.09)
#   adapter-lw          кандидат 1, не принят: только для повторов замера, предупреждение в /v1/health
# SVS_CV_ADAPTER — путь к карте, пусто — $SVS_DATA_DIR/index/cv-adapter-lw.npz (кладёт
# deploy/pack_data.sh). Карта собрана под индекс visual-s2so400m.npz sha1 ccd3a01f: нет карты или
# индекс другой — сервис не стартует и в причине отказа пишет SVS_CANDIDATE=off. При off
# SVS_CV_ADAPTER задавать нельзя.
SVS_CANDIDATE=
SVS_CV_ADAPTER=

# ============================================================ 3. Только нативный запуск
# В Docker их задают compose и образ: /data, /dataset, 0.0.0.0:8080, cuda или cpu по профилю.
# SVS_DATA_DIR=./data
# SVS_DATASET_DIR="../Датасет"
# SVS_HOST=0.0.0.0
# SVS_PORT=8080
# SVS_DEVICE=cuda

# ============================================================ 4. Полевой контур (app/api/field.py)
# Страница съёмки и архив кадров. Архив пишет каждый кадр на диск; в Docker по умолчанию
# $SVS_DATA_DIR/field, а /data смонтирован только на чтение — кадры не сохраняются.
# Для полевого стенда — отдельный том на запись и путь к нему здесь.
SVS_FIELD_DIR=
# Пересжатые фото каталога (scripts/make_photo_pack.py). В Docker по умолчанию
# /data/catalog/photos_small.
SVS_FIELD_PHOTO_DIR=
# Общий ключ полевых маршрутов: ссылка вида http://адрес/field?k=КЛЮЧ. Пусто — открыто всем.
SVS_FIELD_TOKEN=
# 1 — зарегистрировать полевой контур (страница съёмки /field и /v1/field/*). Пусто — контура нет:
# продуктовая сборка кадров на диск не пишет (152-ФЗ). На полевом стенде VPS — SVS_FIELD=1.
SVS_FIELD=

# ============================================================ 5. Слой после поиска (app/api/after.py)
# Лёгкие фото каталога для карточки и похожих; пусто — SVS_FIELD_PHOTO_DIR или
# $SVS_DATA_DIR/catalog/photos_small.
SVS_PHOTO_DIR=
# Словарь групп вин (wines.jsonl: группы «то же вино», ключ винодельни, сорта выгрузки). Пусто —
# $SVS_DATA_DIR/catalog/wines.jsonl. Факты вина — только выгрузка организатора (gt_tokens.jsonl).
SVS_WINES_PATH=

# ============================================================ 6. Сомелье (app/api/somm.py, app/sommelier)
# Выключатели: 1/true/on/yes и 0/false/off/no; пусто — по умолчанию.
# 0 — живого голоса нет: ответы листа — шаблон «Текст и подбор — алгоритм». Пусто — 1.
SVS_SOMM_LIVE=
# 0 — поле вопроса текстом выключено (422), работают только чипы. Пусто — 1.
SVS_SOMM_INPUT=
# Данные сомелье (pairs.json, dishes.json, serve.json, vocab.json, knowledge.json; docs/api-sommelier.md,
# §7) — и для чипов «К чему?» у полки. Пусто — $SVS_DATA_DIR/somm. Снимок портала (SVS_PORTAL_DIR)
# больше не читается (решение 24.09).
SVS_SOMM_DIR=
# Предел живого голоса, мс, и тихое окно после каждого /v1/eval/predict, с. Пусто — 4000 и 15.
SVS_SOMM_TIMEOUT_MS=
SVS_SOMM_QUIET_S=
# 1 — смысловой слой барьера: окольные фразы (зависимость, трезвость, здоровье) по rubert-tiny2 из
# локального кэша Hugging Face, на CPU, без скачивания. Пусто — 0: замер 24.09
# (research/2026-09-24_somm/safety_eval.json) не нашёл порога, где слой ловит больше правил без
# лишних отказов. Нет весов в кэше — слой молчит, /v1/health.somm.safety.status = missing.
SVS_SOMM_SAFETY=
