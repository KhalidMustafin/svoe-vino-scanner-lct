# Полевой стенд на VPS без видеокарты. Скопировать в /etc/svs-field.env и поправить пути.
#
# Главное отличие от боевых настроек — бюджеты. Заводские 8000/5000 мс рассчитаны на
# видеокарту; на процессоре чтение этикетки в них не укладывается, сервис молча выбрасывает
# текст и отвечает одной картинкой. Внешне это выглядит как работающий сервис, а на деле — уже
# другой алгоритм. Поэтому бюджеты подняты до минут: в поле ждать не жалко.

SVS_DEVICE=cpu
SVS_BUDGET_MS=600000
SVS_VLM_TIMEOUT_MS=540000

# Полевой контур: страница съёмки, приём кадров в архив и отметки. Без флага его маршрутов нет
# вовсе — продукт кадров на диск не пишет (152-ФЗ). Стенд ради этого и поднят, поэтому здесь 1.
SVS_FIELD=1

# Где лежат индекс, словарь, признаки каталога и архив кадров.
SVS_DATA_DIR=/opt/svs/data
# Выгрузка организатора: нужна только ради описаний в карточке, можно не класть.
SVS_DATASET_DIR=/opt/svs/dataset
# Пересжатый каталог фото (scripts/make_photo_pack.py) — человек сверяет бутылку глазами.
SVS_FIELD_PHOTO_DIR=/opt/svs/data/catalog/photos_small
# Кадры и ответы полевого прогона. Их ради этого стенда всё и затевалось — не потеряйте.
SVS_FIELD_DIR=/opt/svs/data/field

# Ключ доступа: ссылка для снимающих — http://АДРЕС/field?k=КЛЮЧ (старая http://АДРЕС/?k=КЛЮЧ
# перенаправляется туда же; на / теперь страница продукта). Пустой — открыто всем.
SVS_FIELD_TOKEN=смените-меня

# Слушать только локально, наружу пускает прокси (Caddy/nginx). 0.0.0.0 — только если
# порт закрыт файрволом и вы понимаете, что авторизации в боевых маршрутах нет.
SVS_HOST=127.0.0.1
SVS_PORT=8080

SVS_OLLAMA_URL=http://127.0.0.1:11434
SVS_VLM_MODEL=qwen3.5:4b
# Модель не должна выгружаться между кадрами: холодная загрузка на CPU — десятки секунд.
SVS_VLM_KEEP_ALIVE=24h
SVS_MAX_UPLOAD_MB=25

# Кэш Hugging Face с весами SigLIP. Сервис их не скачивает: положите заранее (deploy/push.sh).
HF_HOME=/opt/svs/hf
