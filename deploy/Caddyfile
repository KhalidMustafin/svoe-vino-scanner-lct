# Наружная дверь полевого стенда: https одной страницей конфига. Пароля Caddy не ставит:
# доступ к стенду — по ключу ?k= (SVS_FIELD_TOKEN), остальные маршруты открыты.
#
#     apt install caddy
#     cp deploy/Caddyfile /etc/caddy/Caddyfile   # и поправьте адрес
#     systemctl reload caddy
#
# Домен нужен только ради https. Без домена работает и голый http://IP:8080 — видоискателя в
# странице нет, съёмка идёт нативной камерой телефона (`capture=environment`), а ей защищённый
# контекст не требуется. Https всё равно стоит поднять: по http ключ ?k= и кадры идут открыто.

скан.пример.рф {
	# Кадр с телефона — до 25 МБ (SVS_MAX_UPLOAD_MB).
	request_body {
		max_size 30MB
	}

	reverse_proxy 127.0.0.1:8080 {
		# На процессоре один кадр идёт десятки секунд, а прогрев службы — минуты. Ответ
		# обрывать нельзя: пользователь уже ушёл бы, а кадр всё равно попал в архив.
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}

	encode zstd gzip
	log {
		output file /var/log/caddy/svs-field.log
	}
}

# Вариант без домена: Caddy выдаст самоподписанный сертификат, телефон покажет
# предупреждение — для своих это терпимо, для показа жюри нет.
# :443 {
# 	tls internal
# 	reverse_proxy 127.0.0.1:8080
# }
